{
  "name": "eidos-bible",
  "version": "0.1.0",
  "private": true,
  "description": "Bible Import, a plugin for Eidos MD.",
  "type": "module",
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
