{
  // F5: builds the plugin and opens Eidos MD on a throwaway sandbox project with it switched on.
  // Breakpoints in src/*.ts stop. Stop the session and the sandbox is removed.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Bible Import",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/eidosmd/dist/src/cli.js",
      "args": ["plugin", "dev", "dist"],
      "preLaunchTask": "build",
      "console": "integratedTerminal"
    }
  ]
}
